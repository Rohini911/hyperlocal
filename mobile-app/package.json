{
  "name": "hyperlocal-emergency-mobile",
  "version": "1.0.0",
  "description": "Hyperlocal Emergency Response Platform - Mobile Application (Android / iOS)",
  "scripts": {
    "init:android": "npx cap add android",
    "init:ios": "npx cap add ios",
    "sync": "npx cap sync",
    "open:android": "npx cap open android",
    "open:ios": "npx cap open ios",
    "build:mobile": "cd ../frontend && npm run build && cd ../mobile-app && npx cap sync"
  },
  "dependencies": {
    "@capacitor/core": "^7.0.0",
    "@capacitor/android": "^7.0.0",
    "@capacitor/ios": "^7.0.0",
    "@capacitor/geolocation": "^7.0.0",
    "@capacitor/app": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0"
  }
}
