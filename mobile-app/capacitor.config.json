{
  "appId": "com.emergency.hyperlocal",
  "appName": "Hyperlocal Emergency",
  "webDir": "../frontend/dist",
  "bundledWebRuntime": false,
  "server": {
    "url": "https://hyperlocal-pi.vercel.app",
    "cleartext": true,
    "androidScheme": "https"
  },
  "android": {
    "allowMixedContent": true
  },
  "plugins": {
    "Geolocation": {
      "permissions": ["location"]
    }
  }
}
